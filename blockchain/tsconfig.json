{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "hardhat"],
    "outDir": "dist",
    "resolveJsonModule": true
  },
  "include": [
    "hardhat.config.ts",
    "scripts",
    "test",
    "typechain-types",
    "contracts"
  ]
}


